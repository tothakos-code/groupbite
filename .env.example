POSTGRES_USER=groupbite
POSTGRES_PASSWORD=groupbite
POSTGRES_HOST=localhost
POSTGRES_DB_NAME=groupbite
POSTGRES_PORT=5432
# possible values: production, development
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
# Host interface docker-compose publishes the app/db ports to.
# Defaults to 127.0.0.1 (loopback only) — safe for local dev and production alike, since
# both assume Docker runs on the same machine you connect from. Only set this to 0.0.0.0
# if something needs to reach the app/db port from a different machine.
# PUBLISH_HOST=0.0.0.0
# Frontend dev server URL (used by backend to proxy non-API requests in development mode)
# Change to http://frontend:8080 when running with docker-compose --profile dev
FRONTEND_DEV_URL=http://127.0.0.1:8080
# Run `python groupbite.py init` to generate all secrets below
# Web push notifications will use these for handshake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=
# Fernet key for encrypting sensitive DB fields (notification keys, smtp password)
FERNET_KEY=
# Flask session signing key
SECRET_KEY=
