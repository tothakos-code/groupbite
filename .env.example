POSTGRES_USER=groupbite
POSTGRES_PASSWORD=groupbite
POSTGRES_HOST=localhost
POSTGRES_DB_NAME=groupbite
POSTGRES_PORT=5432
# possible values: production, development
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
# Run `python groupbite.py init` to generate all secrets below
# Web push notifications will use these for handshake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=
# Fernet key for encrypting sensitive DB fields (notification keys, smtp password)
FERNET_KEY=
# Flask session signing key
SECRET_KEY=
